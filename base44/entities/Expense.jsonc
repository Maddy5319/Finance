{
  "name": "Expense",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "What the money was spent on"
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "description": "Amount spent"
    },
    "category_id": {
      "type": "string",
      "description": "Id of the category"
    },
    "category_name": {
      "type": "string",
      "description": "Category name copied at the time of logging"
    },
    "color": {
      "type": "string",
      "default": "slate",
      "description": "Category colour key copied at the time of logging"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date the expense happened, YYYY-MM-DD"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "upi",
        "card",
        "cash",
        "bank_transfer",
        "other"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow",
        "green",
        "gray"
      ],
      "default": "upi",
      "description": "How it was paid"
    },
    "note": {
      "type": "string",
      "maxLength": 500,
      "description": "Optional note"
    }
  },
  "required": [
    "title",
    "amount",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}